[Unit]
Description=Shawn M1 Q4 Core Container — ISO 20022 Auto-Receive Gate
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shawn-m1
ExecStart=/usr/bin/python3 /opt/shawn-m1/server.py
Restart=always
RestartSec=5
Environment=M1_PORT=8881
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
